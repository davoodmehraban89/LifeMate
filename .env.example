# LifeGuide self-hosted stack. Copy to .env; never commit .env or TLS keys.
COMPOSE_PROJECT_NAME=lifeguide-stage0
POSTGRES_DB=lifemate
POSTGRES_USER=lifeguide
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_SECRET
# Bootstrap credentials above are only for postgres and short-lived ops jobs.
# Do not reuse them in API/migrations/backups. Names are protocol identifiers.
API_DB_USER=lifeguide_api
API_DB_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
MIGRATOR_DB_USER=lifeguide_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_TO_A_THIRD_RANDOM_SECRET
BACKUP_DB_USER=lifeguide_backup
BACKUP_DB_PASSWORD=CHANGE_ME_TO_A_FOURTH_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_APP_URL=https://192.168.1.10
CORS_ORIGINS=https://192.168.1.10
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# Dedicated API/gateway network; change both values if your LAN/VPN overlaps.
PROXY_SUBNET=172.30.86.0/24
GATEWAY_PROXY_IP=172.30.86.10
TLS_CERT_PATH=./deployment/tls/server.pem
TLS_KEY_PATH=./deployment/tls/server-key.pem
API_IMAGE=lifeguide-api:local
WEB_IMAGE=lifeguide-web:local
NODE_ENV=production
LOG_REQUESTS=false
# Session refresh/logout are separately bounded; sensitive auth keeps its own limit.
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW_SECONDS=600
# Delivery is unavailable until an operator configures an approved provider.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=disabled
# These are manual approval gates, not evidence that approval or delivery happened.
# Keep false until the owner authorizes live SMS and Kavenegar approves the template.
SMS_LIVE_ENABLED=false
KAVENEGAR_TEMPLATE_APPROVED=false
# For an approved Kavenegar VerifyLookup template, opt in with SMS_PROVIDER=kavenegar.
# Enter the secret API key in server-side environment / secret manager ONLY.
# Never put it in the public GitHub repo, Flutter, PWA or logs.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=lifeguideotp
# Alternative: owner-selected generic HTTPS SMS webhook.
# Leave these blank while disabled. Store the real token only in private env/secrets.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=14
BACKUP_MAX_AGE_SECONDS=93600
# Experimental child identity: synthetic local fixtures ONLY; production always denies.
ENABLE_CHILD_IDENTITY_SANDBOX=false
