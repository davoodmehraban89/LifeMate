{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeguide-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "LOG_REQUESTS": "true"
  }
}
